user default off resetpass resetkeys resetchannels -@all
user orchestrator on #@@ORCHESTRATOR_SHA256@@ resetkeys resetchannels -@all +eval +get +set +exists +del +sadd +smembers +scard +sismember +rpush +type +xadd +xrevrange +hgetall +multi +exec +discard ~task.registration:* ~task.status:* ~task.lineage:* ~task.input:* ~task.authority:* ~task.authority_grant:* ~task.required_capability:* ~task.children:* ~task.artifact:* ~task.artifacts:* ~task.continuation:* ~task.continuation_latest:* ~task.claim:* ~task.claim_deadline:* ~task.claim_expiry:* ~task.fence:* ~task.delegation_proposal:* ~task.consumed_waves:* ~task.consumed_grants:* ~task.delegation_decisions:* ~task.assignment_yield:* ~task.completion:* ~task.outcome:* ~task.result:* ~task.assignment_completion:* ~task.child_completion:* ~task.recovery_decision:* ~task.routing:* ~agent.hints.general ~agent.hints.research ~agent.hints.analysis ~agent.events %R~agent.ids %R~agent.state:* (+rpush ~agent.tasks.general ~agent.tasks.research ~agent.tasks.analysis)
user worker-1 on #@@WORKER_1_SHA256@@ resetkeys resetchannels -@all (+blpop ~agent.tasks.general ~agent.hints.general) (+sadd ~agent.ids) (+hset ~agent.state:worker-1) (+xadd ~agent.events)
user research-agent-1 on #@@RESEARCH_AGENT_1_SHA256@@ resetkeys resetchannels -@all (+blpop ~agent.tasks.research ~agent.hints.research) (+sadd ~agent.ids) (+hset ~agent.state:research-agent-1) (+xadd ~agent.events)
user research-agent-2 on #@@RESEARCH_AGENT_2_SHA256@@ resetkeys resetchannels -@all (+blpop ~agent.tasks.research ~agent.hints.research) (+sadd ~agent.ids) (+hset ~agent.state:research-agent-2) (+xadd ~agent.events)
user analysis-agent-1 on #@@ANALYSIS_AGENT_1_SHA256@@ resetkeys resetchannels -@all (+blpop ~agent.tasks.analysis ~agent.hints.analysis) (+sadd ~agent.ids) (+hset ~agent.state:analysis-agent-1) (+xadd ~agent.events)
user healthcheck on #@@HEALTHCHECK_SHA256@@ resetkeys resetchannels -@all +ping
