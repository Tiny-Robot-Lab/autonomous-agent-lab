APP_ENV=development
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
# ANALYSIS_TASK_QUEUE=agent.tasks.analysis

# Task Delivery Mode and Authenticated Claim (v0.6.0 / Issue #224)
# TASK_DELIVERY_MODE=legacy_push
# CLAIM_DELIVERY_LEASE_SECONDS=30.0
# CHILD_CLAIM_DEADLINE_SECONDS=120.0
# EXECUTION_CLAIM_TIMEOUT_SECONDS=900.0
#
# Atomic Lifecycle Security Configuration:
# RUNTIME_CREDENTIAL_PEPPER, ASSIGNMENT_PROOF_PEPPER, and RUNTIME_PRINCIPALS_JSON form an atomic group:
# - Under legacy_push, leaving all three completely absent is supported (pure legacy queue delivery).
# - Lifecycle environment variables must either all be omitted or all contain valid nonempty values;
#   explicitly empty or whitespace-only values are invalid and fail startup.
# - Supplying a partial or malformed lifecycle configuration in either mode fails startup closed.
# - Every configured principal requires an explicit nonempty bound_agent_id; principal and agent identities
#   are not interchangeable (no fallback binds principal_id as bound_agent_id).
# - Valid credentials alone do not enable multi-agent delegation; TASK_DELIVERY_MODE=authenticated_claim
#   remains strictly required for executable delegation.
#
# RUNTIME_CREDENTIAL_PEPPER=<high-entropy secret for HMAC bearer token verification>
# ASSIGNMENT_PROOF_PEPPER=<base64-encoded >=32-byte master secret for assignment proofs>
#
# Reference Multi-Principal Configuration:
# Generates HMAC SHA-256 token digests for runtime principals using RUNTIME_CREDENTIAL_PEPPER:
#   python -c "import hashlib, hmac; print(hmac.new(b'<PEPPER>', b'<TOKEN>', hashlib.sha256).hexdigest())"
#
# RUNTIME_PRINCIPALS_JSON='{
#   "principal-research-1": {"principal_id": "principal-research-1", "bound_agent_id": "research-agent-1", "authorized_capabilities": ["research"], "token_digest": "<HMAC_SHA256_RESEARCH_1>", "active": true},
#   "principal-research-2": {"principal_id": "principal-research-2", "bound_agent_id": "research-agent-2", "authorized_capabilities": ["research"], "token_digest": "<HMAC_SHA256_RESEARCH_2>", "active": true},
#   "principal-analysis-1": {"principal_id": "principal-analysis-1", "bound_agent_id": "analysis-agent-1", "authorized_capabilities": ["analysis"], "token_digest": "<HMAC_SHA256_ANALYSIS_1>", "active": true},
#   "principal-worker-1": {"principal_id": "principal-worker-1", "bound_agent_id": "worker-1", "authorized_capabilities": ["general"], "token_digest": "<HMAC_SHA256_WORKER_1>", "active": true}
# }'
#
# Runtime Bearer Tokens matching the principals above (injected into agent containers):
# RUNTIME_TOKEN_RESEARCH_1=
# RUNTIME_TOKEN_RESEARCH_2=
# RUNTIME_TOKEN_ANALYSIS_1=
# RUNTIME_TOKEN_WORKER=

# Optional Research and Inference Providers (defaults to 'stub' without credentials)
# INFERENCE_PROVIDER=stub
# HEALTH_PROBE_TIMEOUT_SECONDS=3.0
# RESEARCH_EXECUTOR=stub
# TAVILY_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_AI_API_TOKEN=
# CLOUDFLARE_AI_MODEL=@cf/mistralai/mistral-small-3.1-24b-instruct
# CLOUDFLARE_AI_MAX_TOKENS=1024
# CLOUDFLARE_TUNNEL_TOKEN=
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_MAX_TOKENS=1024
